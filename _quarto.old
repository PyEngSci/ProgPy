project:
  type: book
  output-dir: docs

jupyter: python3

execute:
  enabled: false
#  freeze: auto
#  error: true 
 
book:
  title: "Programming in Python"
  author: "Nick McCullen"
  date-format: "YYYY-MM-DD"
  chapters:
    - index.qmd
    - Lesson01/01-Python_Basics.ipynb
    - Lesson02/02-Variables.ipynb
    - Lesson03/03-Functions.ipynb
    - Lesson04/04-If_and_While.ipynb
    - Lesson05/05-Lists-Dictionaries.ipynb
    - Lesson06/06-For_Loops.ipynb
    - Lesson07/07-Numerical_Arrays.ipynb
    - Lesson08/08-Data_Analysis.ipynb
    - Lesson09/09-Debugging_Code.ipynb
    - Lesson10/10-Writing_Programs.ipynb
    
format:
  html:
    number-sections: true
    number-depth: 3
    include-in-header:
      text: |
        <script>
        document.addEventListener("DOMContentLoaded", () => {
          document
            .querySelectorAll('a[href*="Notebooks/solutions/"]')
            .forEach(link => {
              link.target = "_blank";
              link.rel = "noopener noreferrer";
            });
        });
        </script>
    code-links:
      - text: Course Files
        icon: download
        href: https://github.com/PyEngSci/ProgPy
        target: _blank

comments:
  hypothesis:
    theme: clean
